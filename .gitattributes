# Git hooks and shell scripts must keep LF line endings on every platform:
# with core.autocrlf=true (Git for Windows default) a CRLF checkout breaks sh.
.githooks/* text eol=lf
*.sh text eol=lf
# Windows batch files must keep CRLF line endings: cmd.exe misreads LF-only batch files.
*.cmd text eol=crlf
